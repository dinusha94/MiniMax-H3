# MiniMax Open Platform (hosted H3-Context-IR)
# Global: https://api.minimax.io   CN: https://api.minimaxi.com
MINIMAX_API_BASE=https://api.minimax.io
MINIMAX_API_TOKEN=

# Self-hosted H3-Base (sglang serve --model-variant fl2va / ref2va)
SGLANG_FL2VA_URL=http://localhost:30010
SGLANG_REF2VA_URL=http://localhost:30012

# Results: MP4s are uploaded to <S3_OUTPUT_FOLDER>/<job_id>/<job_id>.mp4
S3_OUTPUT_FOLDER=s3://your-bucket/h3-outputs/
S3_PRESIGN_EXPIRES_S=3600
# Region of the output bucket (used by s3_utils.generate_presigned_url)
S3_AWS_REGION=us-east-1
# AWS credentials: use an IAM role, ~/.aws, or
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Local scratch space for videos before upload
OUTPUT_DIR=./data/outputs

H3_SHORT_EDGE=768
H3_NUM_INFERENCE_STEPS=20
# Cache-DiT (needs SGLANG_CACHE_DIT_ENABLED=true on the SGLang services)
H3_CACHE_DIT_ENABLED=true
H3_CACHE_DIT_THRESHOLD=0.12
H3_CACHE_DIT_MAX_CACHED_STEPS=2
H3_CACHE_DIT_WARMUP_STEPS=4
POLL_INTERVAL_S=5
CONTEXT_IR_TIMEOUT_S=900
H3_BASE_TIMEOUT_S=3600
